# Copy to .env.prod and fill secrets before deploy.

# Postgres
POSTGRES_USER=transcriptor
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=transcriptor

# Auth
AUTH_EMAILS=jesusebzcp19@gmail.com
# Generate: python -c "from passlib.hash import argon2; print(argon2.hash('your-password'))"
# IMPORTANT for Docker Compose: escape every $ as $$ in argon2 hashes.
AUTH_PASSWORD_HASH_VALUE=$$argon2id$$v=19$$m=65536,t=3,p=4$$replace$$replace
JWT_SECRET=change-me-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# Whisper
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=true

# Web
# Empty means same-origin: nginx serves web and proxies /api to FastAPI.
VITE_API_URL=
WEB_PORT=80
