# Postgres
POSTGRES_USER=transcriptor
POSTGRES_PASSWORD=transcriptor
POSTGRES_DB=transcriptor
DATABASE_URL=postgresql+asyncpg://transcriptor:transcriptor@localhost:5432/transcriptor

# Auth
AUTH_EMAILS=jesusebzcp19@gmail.com
# Set to the output of: python -c "from passlib.hash import argon2; print(argon2.hash('your-password'))"
AUTH_PASSWORD_HASH_VALUE=
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# Whisper
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=true
UPLOAD_DIR=/tmp/coding-power-uploads

# Web
VITE_API_URL=http://localhost:8001
